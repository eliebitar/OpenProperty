# OpenProperty Configuration

# Keycloak Authentication
# Set KEYCLOAK_ENABLED to true to enable Keycloak Single Sign-On
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=openproperty
KEYCLOAK_CLIENT_ID=openproperty-client
KEYCLOAK_REQUIRED=false

# Frontend (Vite) Keycloak Environment Variables
# If not set, the frontend will automatically discover configuration from /api/auth/config
VITE_KEYCLOAK_ENABLED=false
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=openproperty
VITE_KEYCLOAK_CLIENT_ID=openproperty-client
VITE_KEYCLOAK_REQUIRED=false
